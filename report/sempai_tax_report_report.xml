<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sempai_tax_report" model="ir.actions.report">
        <field name="name">Sempai Space Tax Report</field>
        <field name="model">sempai.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sempai_tax_report.sempai_tax_report_document</field>
        <field name="report_file">sempai_tax_report.sempai_tax_report_document</field>
        <field name="print_report_name">'Sempai Space Tax Report'</field>
    </record>

    <record id="action_sempai_tax_report_xlsx" model="ir.actions.report">
        <field name="name">Sempai Space Tax Report (Excel)</field>
        <field name="model">sempai.tax.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">sempai_tax_report.sempai_tax_report_xlsx</field>
        <field name="report_file">sempai_tax_report.sempai_tax_report_xlsx</field>
        <field name="print_report_name">'Sempai Space Tax Report'</field>
    </record>
</odoo>
