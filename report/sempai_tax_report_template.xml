<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sempai_tax_report_document">
        <t t-call="web.html_container">

            <div class="page">

                <h2>Sempai Tax Report</h2>

                <p>
                    Start Date:
                    <span t-out="date_start"/>
                </p>

                <p>
                    End Date:
                    <span t-out="date_end"/>
                </p>

                <p>
                    Sale Invoices Found:
                    <span t-out="len(invoices)"/>
                </p>

                <br/>

                <!-- ================================================= -->
                <!-- SALES -->
                <!-- ================================================= -->

                <h3 style="margin-top: 20px;">
                    Sales
                </h3>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th>Partner</th>
                            <th>Currency</th>
                            <th>Subtotal</th>
                            <th>Taxes</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="invoices" t-as="invoice">

                            <tr>

                                <td>
                                    <span t-out="invoice.name"/>
                                </td>

                                <td>
                                    <span t-out="invoice.invoice_date"/>
                                </td>

                                <td>
                                    <span t-out="invoice.partner_id.display_name"/>
                                </td>
                                <td>
                                    <span t-out="invoice.currency_id.name"/>
                                </td>
                                <td class="text-end">
                                    <span t-out="'%.2f' % invoice.amount_untaxed"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % invoice.amount_tax"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % invoice.amount_total"/>
                                </td>

                            </tr>

                        </t>
                        <tr>
                            <td colspan="4" class="text-end">
                                <strong>Total Sales</strong>
                            </td>

                            <td class="text-end">
                                <strong>
                                    <span t-out="'%.2f' % sales_subtotal"/>
                                </strong>
                            </td>

                            <td class="text-end">
                                <strong>
                                   <span t-out="'%.2f' % sales_tax"/> 
                                </strong>
                            </td>

                            <td class="text-end">
                                <strong>
                                    <span t-out="'%.2f' % sales_total"/> 
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="not invoices">
                    <p>
                        No invoices found for this period.
                    </p>
                </t>

                <!-- ================================================= -->
                <!-- SALES TAX SUMMARY -->
                <!-- ================================================= -->

                <h3 style="margin-top: 30px;">
                    Sales Tax Summary
                </h3>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Tax Group</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="tax_groups.values()" t-as="tax_group">

                            <tr>

                                <td>
                                    <span t-out="tax_group['name']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax_group['subtotal']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax_group['tax']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax_group['total']"/>
                                </td>

                            </tr>

                        </t>

                    </tbody>
                </table>

                <!-- ================================================= -->
                <!-- PURCHASES -->
                <!-- ================================================= -->

                <h3 style="margin-top: 20px;">
                    Purchases
                </h3>

                <t t-if="purchases">

                    <table class="table table-sm">

                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th>Partner</th>
                                <th>Currency</th>
                                <th>Subtotal</th>
                                <th>Taxes</th>
                                <th>Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="purchases" t-as="purchase">

                                <tr>

                                    <td>
                                        <span t-out="purchase.name"/>
                                    </td>

                                    <td>
                                        <span t-out="purchase.invoice_date"/>
                                    </td>

                                    <td>
                                        <span t-out="purchase.partner_id.display_name"/>
                                    </td>

                                    <td>
                                        <span t-out="purchase.currency_id.name"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-out="'%.2f' % purchase.amount_untaxed"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-out="'%.2f' % purchase.amount_tax"/>
                                    </td>

                                    <td class="text-end">
                                        <span t-out="'%.2f' % purchase.amount_total"/>
                                    </td>

                                </tr>

                            </t>
                            <tr>
                                <td colspan="4" class="text-end">
                                    <strong>Total Purchases</strong>
                                </td>

                                <td class="text-end">
                                    <strong>
                                        <span t-out="'%.2f' % purchase_subtotal"/>
                                    </strong>
                                </td>

                                <td class="text-end">
                                    <strong>
                                        <span t-out="'%.2f' % purchase_tax"/>
                                    </strong>
                                </td>

                                <td class="text-end">
                                    <strong>
                                        <span t-out="'%.2f' % purchase_total"/>
                                    </strong>
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </t>

                <t t-if="not purchases">
                    <p>
                        No purchase invoices found for this period.
                    </p>
                </t>

                <!-- ================================================= -->
                <!-- PURCHASE TAX SUMMARY -->
                <!-- ================================================= -->

                <h3>
                    Purchase Tax Summary
                </h3>

                <table class="table table-sm">

                    <thead>
                        <tr>
                            <th>Tax Group</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="purchase_tax_groups.values()" t-as="tax">

                            <tr>

                                <td>
                                    <span t-out="tax['name']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax['subtotal']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax['tax']"/>
                                </td>

                                <td class="text-end">
                                    <span t-out="'%.2f' % tax['total']"/>
                                </td>

                            </tr>

                        </t>

                    </tbody>

                </table>

            </div>

        </t>
    </template>

</odoo>
