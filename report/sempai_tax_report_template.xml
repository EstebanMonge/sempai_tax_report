<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sempai_tax_report_document">
        <t t-call="web.html_container">

            <div class="page">

                <h2>Sempai Tax Report</h2>

                <p>
                    Start Date:
                    <span t-esc="date_start"/>
                </p>

                <p>
                    End Date:
                    <span t-esc="date_end"/>
                </p>

                <p>
                    Sale Invoices Found:
                    <span t-esc="len(invoices)"/>
                </p>

                <br/>
                <h3 style="margin-top: 20px;">
                    Sales
                </h3>
<t t-if="invoices">
    <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th>Partner</th>
                            <th>Currency</th>
                            <th>Subtotal</th>
                            <th>Taxes</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="invoices" t-as="invoice">

                            <tr>

                                <td>
                                    <span t-esc="invoice.number"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.date_invoice"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.partner_id.display_name"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.currency_id.name"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.amount_untaxed"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.amount_tax"/>
                                </td>

                                <td>
                                    <span t-esc="invoice.amount_total"/>
                                </td>

                            </tr>

                        </t>

<tr>
    <td colspan="4">
        <strong>Total Sales</strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_subtotal"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_tax"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % sales_total"/>
        </strong>
    </td>
</tr>
                    </tbody>
    </table>
</t>
<t t-if="not invoices">
    <p>
        No invoices found for this period.
    </p>
</t>
<h3 style="margin-top: 30px;">
    Sales Tax Summary
</h3>

<table class="table table-condensed">
    <thead>
        <tr>
            <th>Tax Group</th>
            <th class="text-right">Subtotal</th>
            <th class="text-right">Tax</th>
            <th class="text-right">Total</th>
        </tr>
    </thead>

    <tbody>
        <t t-foreach="tax_groups.values()" t-as="tax_group">
            <tr>
                <td>
                    <span t-esc="tax_group['name']"/>
                </td>

                <td class="text-right">
                    <span t-esc="'%.2f' % tax_group['subtotal']"/>
                </td>

                <td class="text-right">
                    <span t-esc="'%.2f' % tax_group['tax']"/>
                </td>

                <td class="text-right">
                    <span t-esc="'%.2f' % tax_group['total']"/>
                </td>
            </tr>
        </t>
    </tbody>
</table>
                <h3 style="margin-top: 20px;">
                    Purchases
                </h3>
<t t-if="purchases">
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Invoice</th>
                <th>Date</th>
                <th>Partner</th>
                <th>Currency</th>
                <th>Subtotal</th>
                <th>Taxes</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            <t t-foreach="purchases" t-as="purchase">
                <tr>
                    <td>
                        <span t-esc="purchase.number"/>
                    </td>

                    <td>
                        <span t-esc="purchase.date_invoice"/>
                    </td>

                    <td>
                        <span t-esc="purchase.partner_id.name"/>
                    </td>
                    <td>
                        <span t-esc="purchase.currency_id.name"/>
                    </td>
                    <td class="text-right">
                        <span t-esc="purchase.amount_untaxed"/>
                    </td>

                    <td class="text-right">
                        <span t-esc="purchase.amount_tax"/>
                    </td>

                    <td class="text-right">
                        <span t-esc="purchase.amount_total"/>
                    </td>
                </tr>
            </t>
<tr>
    <td colspan="4">
        <strong>Total Purchases</strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % purchase_subtotal"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % purchase_tax"/>
        </strong>
    </td>

    <td class="text-right">
        <strong>
            <span t-esc="'%.2f' % purchase_total"/>
        </strong>
    </td>
</tr>

        </tbody>
    </table>
</t>
<t t-if="not purchases">
    <p>
        No purchase invoices found for this period.
    </p>
</t>
<h3>Purchase Tax Summary</h3>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Tax Group</th>
            <th class="text-right">Subtotal</th>
            <th class="text-right">Tax</th>
            <th class="text-right">Total</th>
        </tr>
    </thead>

    <tbody>
        <t t-foreach="purchase_tax_groups.values()" t-as="tax">
            <tr>
                <td>
                    <span t-esc="tax['name']"/>
                </td>
                <td class="text-right">
                    <span t-esc="tax['subtotal']"/>
                </td>
                <td class="text-right">
                    <span t-esc="tax['tax']"/>
                </td>
                <td class="text-right">
                    <span t-esc="tax['total']"/>
                </td>
            </tr>
        </t>
    </tbody>
</table>

<h2 style="page-break-before: always;">
    Sales by Economic Activity
</h2>

<t t-foreach="economic_activities" t-as="economic_activity">

    <h3 style="margin-top: 20px;">
        Economic Activity:
        <span t-esc="economic_activity['code']"/>
        <t t-if="economic_activity['code']"> - </t>
        <span t-esc="economic_activity['name']"/>
    </h3>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Invoice</th>
                <th>Date</th>
                <th>Partner</th>
                <th>Currency</th>
                <th>Subtotal</th>
                <th>Taxes</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            <t t-foreach="economic_activity['invoices']" t-as="invoice">

                <tr>

                    <td>
                        <span t-esc="invoice.number"/>
                    </td>

                    <td>
                        <span t-esc="invoice.date_invoice"/>
                    </td>

                    <td>
                        <span t-esc="invoice.partner_id.display_name"/>
                    </td>

                    <td>
                        <span t-esc="invoice.currency_id.name"/>
                    </td>

                    <td>
                        <span t-esc="invoice.amount_untaxed"/>
                    </td>

                    <td>
                        <span t-esc="invoice.amount_tax"/>
                    </td>

                    <td>
                        <span t-esc="invoice.amount_total"/>
                    </td>

                </tr>

            </t>

            <tr>
                <td colspan="4">
                    <strong>Total Sales</strong>
                </td>

                <td class="text-right">
                    <strong>
                        <span t-esc="'%.2f' % economic_activity['subtotal']"/>
                    </strong>
                </td>

                <td class="text-right">
                    <strong>
                        <span t-esc="'%.2f' % economic_activity['tax']"/>
                    </strong>
                </td>

                <td class="text-right">
                    <strong>
                        <span t-esc="'%.2f' % economic_activity['total']"/>
                    </strong>
                </td>
            </tr>

        </tbody>
    </table>

    <h4 style="margin-top: 10px;">
        Sum of Sales by Tax
    </h4>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th>Tax Group</th>
                <th class="text-right">Subtotal</th>
                <th class="text-right">Tax</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>

        <tbody>
            <t t-foreach="economic_activity['tax_groups'].values()" t-as="tax_group">
                <tr>
                    <td>
                        <span t-esc="tax_group['name']"/>
                    </td>

                    <td class="text-right">
                        <span t-esc="'%.2f' % tax_group['subtotal']"/>
                    </td>

                    <td class="text-right">
                        <span t-esc="'%.2f' % tax_group['tax']"/>
                    </td>

                    <td class="text-right">
                        <span t-esc="'%.2f' % tax_group['total']"/>
                    </td>
                </tr>
            </t>
        </tbody>
    </table>

</t>
            </div>

        </t>
    </template>

</odoo>
