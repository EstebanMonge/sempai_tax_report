<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sempai_tax_report_wizard" model="ir.ui.view">
        <field name="name">sempai.tax.report.wizard.form</field>
        <field name="model">sempai.tax.report.wizard</field>
        <field name="arch" type="xml">
<form string="Sempai Space Report">

    <group>
        <group>
            <field name="date_start"/>
        </group>

        <group>
            <field name="date_end"/>
        </group>
    </group>

    <footer>
        <button
            name="action_print_report"
            string="Print PDF"
            type="object"
            class="oe_highlight"/>
        <button
            name="action_export_xlsx"
            string="Export Excel"
            type="object"
            class="oe_highlight"/>
        <button
            string="Cancel"
            class="oe_link"
            special="cancel"/>
    </footer>

</form>
        </field>
    </record>

<record id="action_sempai_tax_report_wizard" model="ir.actions.act_window">
    <field name="name">Sempai Space Tax Report</field>
    <field name="res_model">sempai.tax.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_sempai_tax_report_wizard"/>
    <field name="target">new</field>
</record>

    <menuitem
        id="menu_sempai_tax_report"
        name="Sempai Space Tax Report"
        parent="account.menu_finance_reports"
        action="action_sempai_tax_report_wizard"
        sequence="50"/>
</odoo>
